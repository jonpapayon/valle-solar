---
import { empresa } from "../data/empresa";

const si = [
  { k: "Instalamos", v: "Sistemas fotovoltaicos interconectados a la red de CFE" },
  { k: "Para", v: "Casas y negocios" },
  { k: "Dónde", v: empresa.region },
];
const no = [
  { k: "No ofrecemos", v: "Sistemas autónomos, aislados de la red" },
  { k: "No ofrecemos", v: "Sistemas de bombeo solar" },
];
---

<section id="servicio" aria-labelledby="titulo-servicio" class="seccion">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-6">
      <p class="etiqueta">Servicio y alcance</p>
      <h2 id="titulo-servicio" class="mt-5 font-serif text-[clamp(2.75rem,1.4rem+4.4vw,5.25rem)] leading-[0.95] tracking-[-0.02em]">
        Un solo oficio: <span class="text-valle">sistemas conectados a la red de CFE</span>
      </h2>
      <p class="mt-8 max-w-[30rem] text-lg leading-relaxed text-tinta-2">
        Nos dedicamos a un tipo de instalación, para casas y negocios de {empresa.region}. Tu inmueble sigue conectado a
        CFE y suma la energía de sus propios paneles.
      </p>
    </div>

    <div class="lg:col-span-6 lg:pt-3">
      <div class="ficha-tecnica">
        <p class="ficha-cabecera">
          <span>Ficha de servicio</span>
          <span aria-hidden="true">SSMX · 01</span>
        </p>
        <ul>
          {
            si.map((f) => (
              <li>
                <span class="k">{f.k}</span>
                <span class="v">{f.v}</span>
                <span class="marca marca-si" role="img" aria-label="Sí">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 7" /></svg>
                </span>
              </li>
            ))
          }
        </ul>
        <ul class="no">
          {
            no.map((f) => (
              <li>
                <span class="k">{f.k}</span>
                <span class="v">{f.v}</span>
                <span class="marca marca-no" role="img" aria-label="No">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 6l8 8M14 6l-8 8" /></svg>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ficha-tecnica {
    border: 1px solid var(--color-basalto);
    border-radius: 4px;
    background: #f8f6ef;
  }
  .ficha-cabecera {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid var(--color-basalto);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .ficha-cabecera span:last-child {
    color: var(--color-tinta-2);
    font-weight: 400;
  }
  ul li {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    border-bottom: 1px solid var(--color-linea);
  }
  ul.no {
    background: var(--color-cal-2);
  }
  ul.no li:last-child {
    border-bottom: 0;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-tinta-2);
  }
  .v {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.15;
  }
  ul.no .v {
    color: var(--color-tinta-2);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(194 65 12 / 0.7);
  }
  .marca {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
  }
  .marca svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .marca-si {
    background: var(--color-valle);
  }
  .marca-si svg {
    stroke: var(--color-cal);
  }
  .marca-no {
    border: 1.5px solid var(--color-tezontle);
  }
  .marca-no svg {
    stroke: var(--color-tezontle-2);
  }
  @media (max-width: 639px) {
    ul li {
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
      padding-inline: 1rem;
    }
    .k {
      grid-column: 1 / -1;
    }
  }
</style>
