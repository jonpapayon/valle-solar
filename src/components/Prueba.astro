---
import { empresa } from "../data/empresa";

const m = empresa.metricas;
const iconos: Record<string, string> = {
  panel:
    '<path d="M5 5h14l2 9H3z"/><path d="M9.7 5L8.3 14M14.3 5l1.4 9M4 9.5h16"/><path d="M12 14v5M8 19h8"/>',
  estrella:
    '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
  equipo:
    '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.5 0 4.5 2 4.5 4.5"/>',
  escudo:
    '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
};
const items = [
  { v: String(m.sistemas), t: "sistemas instalados", i: "panel" },
  { v: m.calificacion.toFixed(1), t: `en Google, ${m.resenas} reseñas`, i: "estrella" },
  { v: String(m.cuadrillas), t: "cuadrillas propias", i: "equipo" },
  { v: `${m.garantiaPaneles} años`, t: "de garantía en paneles", i: "escudo" },
];
---

<section class="border-y border-edge bg-card">
  <div class="mx-auto grid max-w-[1240px] gap-8 px-6 py-10 sm:grid-cols-2 md:px-12 lg:grid-cols-4">
    {
      items.map((it) => (
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-lima text-bosque">
            <svg
              viewBox="0 0 24 24"
              class="size-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={iconos[it.i]}
            />
          </span>
          <div>
            <div class="text-3xl font-semibold tabular-nums leading-tight">{it.v}</div>
            <div class="text-base text-muted">{it.t}</div>
          </div>
        </div>
      ))
    }
  </div>
</section>