---
import { empresa } from "../data/empresa";
import { urlWhatsApp } from "../lib/whatsapp";
import Calculadora from "./Calculadora.astro";
import PerfilValle from "./PerfilValle.astro";

const wa = urlWhatsApp(empresa.whatsapp.numero, `Hola, ${empresa.nombre}. Quiero cotizar un sistema fotovoltaico interconectado.`);
---

<section id="inicio" aria-labelledby="titulo-inicio" class="relative overflow-hidden">
  <div class="wrap grid gap-12 pb-10 pt-10 sm:pt-14 lg:grid-cols-12 lg:gap-x-8 lg:pb-6 lg:pt-14">
    <!-- Texto -->
    <div class="flex flex-col lg:col-span-5" data-enter>
      <p class="etiqueta flex items-center gap-3" style="--i:0">
        <span class="inline-block h-px w-8 bg-basalto"></span>
        {empresa.region} · Instalación fotovoltaica
      </p>
      <h1
        id="titulo-inicio"
        class="mt-6 font-serif text-[clamp(3rem,1.6rem+4.6vw,5.5rem)] leading-[0.94] tracking-[-0.02em]"
        style="--i:1"
      >
        Paneles solares <em class="italic text-valle">interconectados</em> a&nbsp;CFE para casas y negocios
      </h1>
      <p class="mt-7 max-w-[30rem] text-lg leading-relaxed text-tinta-2" style="--i:2">
        Instalamos sistemas fotovoltaicos conectados a la red de CFE. Tu techo produce parte de la electricidad que
        consumes y una parte menor de tu dinero se va al recibo.
      </p>

      <div class="mt-8 flex flex-wrap gap-3" style="--i:3">
        <a href="#calculadora" class="btn btn-primario w-full sm:w-auto lg:hidden">Calcular mi sistema</a>
        <a href="#como-funciona" class="btn btn-secundario hidden lg:inline-flex">Ver cómo funciona</a>
      </div>

      <dl class="ficha mt-10 lg:mt-auto lg:pt-10" style="--i:4">
        <div><dt>Servicio</dt><dd>Solo sistemas interconectados a CFE</dd></div>
        <div><dt>Clientes</dt><dd>Casas y negocios</dd></div>
        <div><dt>Cobertura</dt><dd>{empresa.region}</dd></div>
        <div>
          <dt>WhatsApp</dt>
          <dd><a href={wa} class="enlace inline-flex min-h-11 items-center font-mono font-medium" data-wa-general>{empresa.whatsapp.visible}</a></dd>
        </div>
      </dl>
    </div>

    <!-- Lámina con la calculadora -->
    <div class="lg:col-span-7 lg:pl-6 xl:pl-10" data-enter>
      <div style="--i:2" class="pb-[10px] pr-[10px]">
        <Calculadora />
      </div>
    </div>
  </div>

  <PerfilValle class="mt-2" />
</section>

<style>
  .ficha {
    display: grid;
    border-top: 1px solid var(--color-basalto);
  }
  .ficha > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 2.875rem;
    border-bottom: 1px solid var(--color-linea);
  }
  .ficha dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-tinta-2);
  }
  .ficha dd {
    font-size: 0.9688rem;
    font-weight: 500;
  }
</style>
