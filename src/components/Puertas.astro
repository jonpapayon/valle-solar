---
import { empresa } from "../data/empresa";

const casos = [
  {
    t: "Casa",
    d: "Baja tu recibo bimestral y deja de depender de la tarifa. Cotización en minutos con tu recibo.",
    i: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  },
  {
    t: "Negocio",
    d: "Comercios, talleres y empacadoras: estudio de consumo con tus recibos de los últimos 12 meses.",
    i: '<path d="M4 21V8l8-4 8 4v13"/><path d="M9 21v-6h6v6"/><path d="M9 11h6"/>',
  },
  {
    t: "Campo",
    d: "Bombeo, riego y agroindustria. Dimensionamos según tu operación y tus horas de mayor consumo.",
    i: '<path d="M12 21v-8"/><path d="M12 13c0-4-3-6-7-6 0 4 3 6 7 6z"/><path d="M12 15c0-3.5 2.5-5.5 6-5.5 0 3.5-2.5 5.5-6 5.5z"/>',
  },
];
---

<section id="casos" class="mx-auto max-w-[1240px] px-6 py-24 md:px-12">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <h2 class="max-w-[14ch] text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-tight">
        Un sistema para cada necesidad
      </h2>
      <p class="mt-4 max-w-[38ch] text-lg leading-relaxed text-muted">
        Atendemos {empresa.zona.slice(0, -1).join(", ")} y {empresa.zona[empresa.zona.length - 1]}.
      </p>
    </div>
    <div class="flex flex-col">
      {
        casos.map((c, i) => (
          <a
            href="#contacto"
            class:list={[
              "flex items-start gap-5 border-t border-edge py-7 transition-colors hover:text-lit",
              i === casos.length - 1 && "border-b",
            ]}
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-lima text-bosque">
              <svg
                viewBox="0 0 24 24"
                class="size-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={c.i}
              />
            </span>
            <span>
              <span class="block text-[28px] font-semibold leading-tight">{c.t}</span>
              <span class="mt-2 block text-[17px] leading-relaxed text-muted">{c.d}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>