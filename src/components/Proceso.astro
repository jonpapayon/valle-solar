---
/* Redacción neutral: quién gestiona el trámite con CFE, costos y tiempos están pendientes de confirmar. */
const pasos = [
  { t: "Compartes tu consumo", d: "Desde la calculadora o por WhatsApp, con los datos de tu recibo de CFE.", e: "Recibo" },
  { t: "Revisamos tu inmueble", d: "Visita técnica para revisar el techo, su orientación y la instalación eléctrica.", e: "Visita" },
  { t: "Instalamos el sistema", d: "Paneles, inversor y conexión con el tablero de tu inmueble.", e: "Obra" },
  { t: "Interconexión con CFE", d: "El sistema se une a la red y entra en operación con el medidor bidireccional.", e: "Operación" },
];
---

<section id="proceso" aria-labelledby="titulo-proceso" class="seccion">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-7">
        <p class="etiqueta">Proceso</p>
        <h2 id="titulo-proceso" class="titulo-2 mt-5">Cómo trabajamos, paso a paso</h2>
      </div>
    </div>

    <ol class="riel mt-14">
      {
        pasos.map((p, i) => (
          <li class="paso">
            <div class="paso-cabeza">
              <span class="paso-num" aria-hidden="true">{i + 1}</span>
              <span class="paso-etapa">{p.e}</span>
            </div>
            <h3 class="mt-6 text-[1.25rem] font-medium leading-snug">{p.t}</h3>
            <p class="mt-2 max-w-[19rem] text-base leading-relaxed text-tinta-2">{p.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .riel {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .riel { grid-template-columns: repeat(2, 1fr); column-gap: 2rem; }
  }
  @media (min-width: 1024px) {
    .riel { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  }
  .paso {
    position: relative;
  }
  .paso-cabeza {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* La línea del riel une los pasos en escritorio */
  @media (min-width: 1024px) {
    .paso-cabeza::after {
      content: "";
      position: absolute;
      left: 4.5rem;
      right: -2rem;
      top: 50%;
      border-top: 1px dashed rgb(22 21 15 / 0.45);
    }
    .paso:last-child .paso-cabeza::after { display: none; }
    .paso-etapa { position: relative; z-index: 1; padding-right: 0.75rem; background: var(--color-cal); }
  }
  .paso-num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--color-basalto);
    font-family: var(--font-serif);
    font-size: 1.875rem;
    line-height: 1;
    background: var(--color-cal);
    position: relative;
    z-index: 1;
  }
  .paso:last-child .paso-num {
    background: var(--color-valle);
    border-color: var(--color-valle);
    color: var(--color-cal);
  }
  .paso-etapa {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-tinta-2);
  }
</style>
