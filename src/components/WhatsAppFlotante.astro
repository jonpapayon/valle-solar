---
import { empresa } from "../data/empresa";

const wa = `https://wa.me/${empresa.whatsapp}?text=${encodeURIComponent("Hola, quiero cotizar paneles solares.")}`;
---

<a
  href={wa}
  aria-label="Escribir por WhatsApp"
  class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-40 inline-flex min-h-12 items-center rounded-full bg-acento px-5 font-semibold text-acento-fg shadow-lg md:hidden"
>
  WhatsApp
</a>