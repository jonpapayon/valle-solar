---
import { empresa } from "../data/empresa";
import { urlWhatsApp } from "../lib/whatsapp";

const wa = urlWhatsApp(
  empresa.whatsapp.numero,
  `Hola, ${empresa.nombre}. Quiero entender cómo se reflejaría un sistema interconectado en mi recibo de CFE.`,
);
---

<section id="recibo" aria-labelledby="titulo-recibo" class="seccion">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-8">
    <!-- Medidor ilustrado: segmentos apagados, sin lecturas reales -->
    <div class="lg:col-span-5">
      <div class="medidor-caja" role="img" aria-label="Ilustración de un medidor bidireccional con dos registros: energía recibida de la red y energía entregada a la red">
        <div class="medidor-tornillos" aria-hidden="true"><span></span><span></span></div>
        <p class="medidor-marca" aria-hidden="true">Medidor bidireccional</p>
        <div class="medidor-pantalla" aria-hidden="true">
          <div class="registro">
            <span class="flecha">↓</span>
            <span class="nombre">Recibida de la red</span>
            <span class="digitos">88888</span>
            <span class="u">kWh</span>
          </div>
          <div class="registro">
            <span class="flecha">↑</span>
            <span class="nombre">Entregada a la red</span>
            <span class="digitos">88888</span>
            <span class="u">kWh</span>
          </div>
        </div>
        <div class="medidor-pie" aria-hidden="true">
          <span class="led"></span>
          <span class="rejilla"></span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <p class="etiqueta">La energía y tu recibo</p>
      <h2 id="titulo-recibo" class="titulo-2 mt-5">Qué registra el medidor y qué pasa con tu recibo de CFE</h2>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-tinta-2">
        Con un sistema interconectado, el medidor bidireccional registra por separado la energía que tomas de la red y la
        que tus paneles entregan a ella cuando sobra.
      </p>

      <div class="aviso sobre-oscuro mt-10">
        <p class="font-serif text-[1.75rem] leading-tight">Tu recibo depende del esquema de interconexión</p>
        <p class="mt-3 text-base leading-relaxed text-[#dedad0]">
          Cómo se compensa la energía que entregas a la red, y cómo se refleja en tu recibo, depende del esquema de
          interconexión que aplique a tu contrato con CFE. No es simplemente la resta entre lo que consumes y lo que
          generas.
        </p>
        <a href={wa} class="enlace mt-6 inline-flex min-h-11 items-center font-medium text-cal">Pregúntanos por tu caso por WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<style>
  .medidor-caja {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: 28px;
    background: linear-gradient(180deg, #e2ddd0, #d6d0c1);
    border: 1px solid rgb(22 21 15 / 0.35);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 30px 60px -36px rgb(22 21 15 / 0.55);
  }
  .medidor-tornillos {
    position: absolute;
    inset: 0.9rem 1rem auto;
    display: flex;
    justify-content: space-between;
  }
  .medidor-tornillos span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #bdb6a5;
    box-shadow: inset 0 1px 1px rgb(22 21 15 / 0.35);
  }
  .medidor-marca {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-tinta-2);
  }
  .medidor-pantalla {
    margin-top: 1rem;
    padding: 1rem 1.125rem;
    border-radius: 10px;
    background: #2a3a30;
    border: 6px solid var(--color-basalto);
    display: grid;
    gap: 0.875rem;
  }
  .registro {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 0.625rem;
    font-family: var(--font-mono);
    color: #dce2d8;
  }
  .flecha {
    color: #f0a27f;
    font-weight: 500;
  }
  .nombre {
    font-size: 0.8125rem;
  }
  .digitos {
    font-size: clamp(1.125rem, 0.8rem + 1.6vw, 2.125rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgb(220 226 216 / 0.16);
    font-variant-numeric: tabular-nums;
  }
  .u {
    font-size: 0.75rem;
  }
  .medidor-pie {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .led {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-tezontle);
    box-shadow: 0 0 0 4px rgb(194 65 12 / 0.18);
  }
  .rejilla {
    width: 40%;
    height: 22px;
    background: repeating-linear-gradient(90deg, rgb(22 21 15 / 0.35) 0 2px, transparent 2px 7px);
    border-radius: 3px;
  }
  .aviso {
    border-radius: 6px;
    background: var(--color-basalto);
    color: var(--color-cal);
    padding: 1.75rem;
    border-left: 4px solid var(--color-tezontle);
  }
  @media (min-width: 640px) {
    .aviso { padding: 2rem 2.25rem; }
  }
  @media (max-width: 400px) {
    .medidor-caja { padding: 1.5rem 1rem 1.25rem; border-radius: 22px; }
    .medidor-pantalla { padding: 0.875rem 0.75rem; border-width: 4px; }
    .nombre { font-size: 0.75rem; }
    .registro { gap: 0.375rem; letter-spacing: 0; }
    .digitos { letter-spacing: 0.02em; }
  }
  @media (min-width: 1024px) {
    .medidor-caja { margin-inline: 0; }
  }
</style>
