---
import { empresa } from "../data/empresa";
import { urlWhatsApp } from "../lib/whatsapp";
import Marca from "./Marca.astro";
import PerfilValle from "./PerfilValle.astro";

const wa = urlWhatsApp(empresa.whatsapp.numero, `Hola, ${empresa.nombre}. Quiero cotizar un sistema fotovoltaico interconectado.`);
const enlaces = [
  { href: "/#calculadora", t: "Calculadora" },
  { href: "/#servicio", t: "Servicio" },
  { href: "/#como-funciona", t: "Cómo funciona" },
  { href: "/#recibo", t: "Tu recibo" },
  { href: "/#soluciones", t: "Casas y negocios" },
  { href: "/#proceso", t: "Proceso" },
  { href: "/#preguntas", t: "Preguntas" },
  { href: "/#contacto", t: "Contacto" },
];
---

<footer class="sobre-oscuro bg-basalto text-cal">
  <PerfilValle tono="oscuro" />
  <div class="wrap grid gap-12 pb-14 pt-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <Marca claro />
      <p class="mt-5 max-w-[24rem] text-base leading-relaxed text-[#dedad0]">
        Sistemas fotovoltaicos interconectados a la red de CFE para casas y negocios en {empresa.region}.
      </p>
    </div>
    <nav id="indice" aria-label="Índice del sitio" class="lg:col-span-4">
      <p class="etiqueta">Índice</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 text-[0.9375rem]">
        {enlaces.map((l) => <li><a href={l.href} class="flex min-h-11 items-center hover:underline">{l.t}</a></li>)}
      </ul>
    </nav>
    <div class="lg:col-span-3">
      <p class="etiqueta">WhatsApp</p>
      <a href={wa} class="mt-3 flex min-h-11 items-center font-mono text-lg hover:underline" data-wa-general>{empresa.whatsapp.visible}</a>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-linea-clara py-5 text-sm text-[#dedad0]">
    <p>© {new Date().getFullYear()} {empresa.nombre}</p>
    <a href="/aviso-de-privacidad" class="flex min-h-11 items-center hover:underline">Aviso de privacidad</a>
  </div>
</footer>
