---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Prueba from "../components/Prueba.astro";
import Puertas from "../components/Puertas.astro";
import Proceso from "../components/Proceso.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";
import { empresa } from "../data/empresa";
---

<Base
  title={`${empresa.nombre} | Paneles solares en ${empresa.ciudad}`}
  description={empresa.lema}
>
  <Nav />
  <Hero />
  <Prueba />
  <Puertas />
  <Proceso />
  <Contacto />
  <Footer />
  <WhatsAppFlotante />
</Base>
