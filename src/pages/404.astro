---
import Base from "../layouts/Base.astro";
import { empresa } from "../data/empresa";
import { urlWhatsApp } from "../lib/whatsapp";

const wa = urlWhatsApp(empresa.whatsapp.numero, `Hola, ${empresa.nombre}. Quiero cotizar un sistema fotovoltaico interconectado.`);
---

<Base title={`Página no encontrada | ${empresa.nombre}`} description="La página que buscas no existe." noindex>
  <section class="seccion">
    <div class="wrap grid min-h-[50svh] content-center gap-6">
      <p class="etiqueta">Error 404</p>
      <h1 class="titulo-2 max-w-[16ch]">Esta página no existe</h1>
      <p class="max-w-[32rem] text-lg leading-relaxed text-tinta-2">
        Puede que el enlace esté mal escrito o que la página haya cambiado de lugar.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/" class="btn btn-primario">Volver al inicio</a>
        <a href={wa} class="btn btn-secundario">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
