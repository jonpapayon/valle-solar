---
import { Font } from "astro:assets";
import "../styles/global.css";
import Encabezado from "../components/Encabezado.astro";
import PiePagina from "../components/PiePagina.astro";
import { empresa } from "../data/empresa";

interface Props {
  title: string;
  description: string;
  /** Evita la indexación (p. ej. la página 404). */
  noindex?: boolean;
  /** Datos estructurados JSON-LD opcionales. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";
---

<!doctype html>
<html lang="es-MX" data-type="service">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-svh font-sans text-[1.0625rem] leading-relaxed antialiased">
    <Encabezado />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <PiePagina />
  </body>
</html>
